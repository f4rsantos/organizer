<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="32dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="6dp"
            android:text="@string/widget_config_title"
            android:textColor="@color/widget_foreground"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="20dp"
            android:text="@string/widget_config_desc"
            android:textColor="@color/widget_muted"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/summary_config_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/summary_config_tasks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_config_item"
                android:layout_marginBottom="8dp"
                android:paddingStart="14dp"
                android:paddingTop="16dp"
                android:paddingEnd="14dp"
                android:paddingBottom="16dp"
                android:text="@string/widget_label_tasks"
                android:textColor="@color/widget_foreground"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/summary_config_events"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_config_item"
                android:layout_marginBottom="8dp"
                android:paddingStart="14dp"
                android:paddingTop="16dp"
                android:paddingEnd="14dp"
                android:paddingBottom="16dp"
                android:text="@string/widget_label_events"
                android:textColor="@color/widget_foreground"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/summary_config_goals"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_config_item"
                android:paddingStart="14dp"
                android:paddingTop="16dp"
                android:paddingEnd="14dp"
                android:paddingBottom="16dp"
                android:text="@string/widget_label_goals"
                android:textColor="@color/widget_foreground"
                android:textSize="15sp" />
        </RadioGroup>

        <Button
            android:id="@+id/summary_config_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/widget_config_button"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:stateListAnimator="@null"
            android:text="@string/widget_config_save"
            android:textAllCaps="false"
            android:textColor="@color/widget_on_accent"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
